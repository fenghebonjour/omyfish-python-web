DEBUG=true
DJANGO_SECRET_KEY=dev-secret-change-in-production
JWT_SECRET=dev-secret-change-in-production-32b
ALLOWED_HOSTS=*

# Omit DATABASE_URL for local `make run` (defaults to SQLite, no GDAL/GEOS needed).
# Set it to use Postgres/PostGIS instead (matches docker-compose):
# DATABASE_URL=postgres://omyfish:omyfish_dev@localhost:5432/omyfish

# Standalone AI microservice (../omyfish-ai) — default assumes it's running on the host
AI_SERVICE_URL=http://localhost:8000
